--- a/wasm/mpc-wasm/mpcrsa/precompute.go
+++ b/wasm/mpc-wasm/mpcrsa/precompute.go
@@ -0,0 +1,59 @@
+package mpcrsa
+
+import (
+ "crypto/rand"
+ "errors"
+ "math/big"
+ "sync"
+ "time"
+ "source.quilibrium.com/quilibrium/monorepo/nekryptology/pkg/paillier"
+)
+
+// One worker owns one short-lived, one-use set. None of this material is
+// serialized to JavaScript or sent over the network by the preparation API.
+type rsaPrecomputation struct {
+ keySize int
+ created time.Time
+ pk *paillier.PublicKey
+ sk *paillier.SecretKey
+ p,q *big.Int
+}
+const precomputationTTL=30*time.Minute
+var precomputationMu sync.Mutex
+var preparedRSA *rsaPrecomputation
+
+func PrepareNPartyRSA(keySize int) error {
+ if keySize!=2048&&keySize!=3072&&keySize!=4096{return errors.New("invalid RSA key size")}
+ precomputationMu.Lock();defer precomputationMu.Unlock()
+ if preparedRSA!=nil&&preparedRSA.keySize==keySize&&time.Since(preparedRSA.created)<precomputationTTL{return nil}
+ preparedRSA=nil
+ reportDKGProgress("offline-paillier-generation-started")
+ pk,sk,err:=paillier.NewKeys();if err!=nil{return err}
+ reportDKGProgress("offline-paillier-generation-finished")
+ // The eventual party number is unknown before the remote task exists.
+ // Prepare the dealer candidate primes too; non-dealers discard them.
+ // This preserves the existing trusted-dealer algorithm, not dealerless DKG.
+ reportDKGProgress("offline-rsa-prime-candidates-started")
+ p,err:=rand.Prime(rand.Reader,keySize/2);if err!=nil{return err}
+ q,err:=rand.Prime(rand.Reader,keySize/2);if err!=nil{return err}
+ preparedRSA=&rsaPrecomputation{keySize:keySize,created:time.Now(),pk:pk,sk:sk,p:p,q:q}
+ reportDKGProgress("offline-preparation-ready")
+ return nil
+}
+func PreparedNPartyRSA(keySize int)bool{
+ precomputationMu.Lock();defer precomputationMu.Unlock()
+ return preparedRSA!=nil&&preparedRSA.keySize==keySize&&time.Since(preparedRSA.created)<precomputationTTL
+}
+func takePreparedRSA(keySize int)(*rsaPrecomputation,error){
+ precomputationMu.Lock();defer precomputationMu.Unlock()
+ if preparedRSA==nil{return nil,errors.New("RSA preparation required before remote CreateKey")}
+ if time.Since(preparedRSA.created)>=precomputationTTL{preparedRSA=nil;return nil,errors.New("RSA preparation expired")}
+ if preparedRSA.keySize!=keySize{return nil,errors.New("RSA preparation key size mismatch")}
+ p:=preparedRSA;preparedRSA=nil;return p,nil
+}
+func InitNPartyRSADKGPrepared(taskID string,keySize int,config *ThresholdConfig,partyID uint32)(*NPartyRSADKGSession,[]byte,error){
+ if taskID==""||config==nil||config.Threshold<2||config.TotalParties<config.Threshold||partyID==0||partyID>config.TotalParties{return nil,nil,errors.New("invalid prepared RSA task parameters")}
+ p,err:=takePreparedRSA(keySize);if err!=nil{return nil,nil,err}
+ reportDKGProgress("offline-preparation-consumed-once")
+ return initNPartyRSADKG(taskID,keySize,config,partyID,p)
+}
